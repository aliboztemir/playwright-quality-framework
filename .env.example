# Test framework environment configuration
# Connection parameters to reach the running test product (Odoo).
# These must match the values configured in c:\Projects\odoo\config\odoo.conf

# --- URLs ---
ODOO_URL=http://localhost:8069
SHOP_URL=http://localhost:8069/shop
ADMIN_URL=http://localhost:8069/web#action=

# Database connection (for repository/DB validation layer)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=odoo
DB_USER=odoo
DB_PASSWORD=odoo_password

# --- Admin credentials ---
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin
